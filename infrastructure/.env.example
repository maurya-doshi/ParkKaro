# ═══════════════════════════════════════════════════════════════
# ParkShare — Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in values.
#
# LOCAL DEVELOPMENT: Use AUTH_MODE=demo, DYNAMODB_ENDPOINT=http://localhost:8000
# PRODUCTION:        Use AUTH_MODE=cognito, no DYNAMODB_ENDPOINT (uses AWS)
# ═══════════════════════════════════════════════════════════════

# ─── AWS Configuration ────────────────────────────────────────
# Region where ParkShare AWS resources are deployed
AWS_REGION=ap-south-1

# Do NOT commit real AWS keys. Use AWS CLI profiles or IAM roles instead.
# These are only needed for local development if not using AWS CLI profiles.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ─── DynamoDB ─────────────────────────────────────────────────
# Table name prefix — must match the CloudFormation DynamoDBTablePrefix parameter
DYNAMODB_TABLE_PREFIX=parkshare

# DynamoDB endpoint — set ONLY for local development with DynamoDB Local
# Comment out or leave empty for AWS production DynamoDB
# DYNAMODB_ENDPOINT=http://localhost:8000

# ─── Cognito (Person 3 configures — values from CloudFormation outputs) ───
# Get these from: aws cloudformation describe-stacks --stack-name parkshare-production
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# ─── S3 (Person 3 configures — value from CloudFormation outputs) ─────────
S3_BUCKET_NAME=

# ─── Bedrock (Person 4 configures) ───────────────────────────
BEDROCK_REGION=ap-south-1

# ─── Application ─────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Platform Business ───────────────────────────────────────
PLATFORM_COMMISSION_PERCENT=10
TAX_PERCENT=0

# ─── Authentication Mode ─────────────────────────────────────
# 'demo'    — Uses X-Demo-* headers (local development only)
# 'cognito' — Uses Authorization: Bearer <JWT> (production)
AUTH_MODE=demo

# ═══════════════════════════════════════════════════════════════
# FRONTEND ENVIRONMENT VARIABLES (for Person 1)
# ═══════════════════════════════════════════════════════════════
# These are provided by Person 3 after deployment:
#
# REACT_APP_API_URL=https://<api-id>.execute-api.ap-south-1.amazonaws.com/production
# REACT_APP_COGNITO_USER_POOL_ID=<from stack outputs>
# REACT_APP_COGNITO_CLIENT_ID=<from stack outputs>
# REACT_APP_S3_BUCKET=<from stack outputs>
# REACT_APP_AWS_REGION=ap-south-1
