# AWS Configuration
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# DynamoDB
DYNAMODB_TABLE_PREFIX=parkshare
DYNAMODB_ENDPOINT=http://localhost:8000

# Cognito (Person 3 configures these)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# S3 (for photo uploads)
S3_BUCKET_NAME=

# Bedrock (Person 4)
BEDROCK_REGION=ap-south-1

# Application
PORT=3001
NODE_ENV=development

# Platform Business
PLATFORM_COMMISSION_PERCENT=10
TAX_PERCENT=0

# Auth Mode: 'cognito' | 'demo'
AUTH_MODE=demo
