{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "rootDirs": [".", "../ai"],
    "paths": {
      "@/*": ["src/*"],
      "@aws-sdk/client-bedrock-runtime": ["./node_modules/@aws-sdk/client-bedrock-runtime"],
      "zod": ["./node_modules/zod"]
    }
  },
  "include": ["src/**/*", "scripts/**/*", "tests/**/*", "../ai/**/*"],
  "exclude": ["node_modules", "dist"]
}
